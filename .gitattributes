# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly declare text files you want normalized
*.ts text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.ico binary
